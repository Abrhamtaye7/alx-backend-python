# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production

# MySQL connection details for Django (host is the docker-compose service name)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=messaging_db
MYSQL_USER=messaging_user
MYSQL_PASSWORD=messaging_password

# MySQL root password used by the MySQL container at initialization
MYSQL_ROOT_PASSWORD=root_password
