pipeline {
  agent any

  environment {
    // Jenkins Credentials IDs you must create in Jenkins:
    // - github-creds: "Username with password" OR "Secret text" token (see note below)
    // - dockerhub-creds: "Username with password" (Docker Hub user + token)
    DOCKERHUB_CREDS = credentials('dockerhub-creds')
    // Change these to your Docker Hub namespace + image name
    DOCKER_IMAGE = "YOUR_DOCKERHUB_USERNAME/messaging_app"
  }

  options {
    timestamps()
    ansiColor('xterm')
  }

  stages {
    stage('Checkout') {
      steps {
        // If repo is public, checkout scm works. If private, configure credentials below.
        // checkout scm

        // More explicit checkout for private repos:
        git branch: 'main',
            credentialsId: 'github-creds',
            url: 'https://github.com/YOUR_GITHUB_USERNAME/alx-backend-python.git'
      }
    }

    stage('Setup Python') {
      steps {
        sh '''
          python3 --version
          python3 -m venv venv
          . venv/bin/activate
          pip install --upgrade pip
          pip install -r messaging_app/requirements.txt
          pip install pytest pytest-cov flake8
        '''
      }
    }

    stage('Lint') {
      steps {
        sh '''
          . venv/bin/activate
          flake8 messaging_app
        '''
      }
    }

    stage('Test (Pytest + JUnit report + Coverage)') {
      steps {
        sh '''
          . venv/bin/activate
          cd messaging_app
          pytest -q --junitxml=pytest-report.xml --cov=. --cov-report=xml --cov-report=term
        '''
      }
      post {
        always {
          junit 'messaging_app/pytest-report.xml'
          archiveArtifacts artifacts: 'messaging_app/pytest-report.xml, messaging_app/coverage.xml', fingerprint: true
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        sh '''
          cd messaging_app
          docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest .
        '''
      }
    }

    stage('Push Docker Image') {
      steps {
        sh '''
          echo "${DOCKERHUB_CREDS_PSW}" | docker login -u "${DOCKERHUB_CREDS_USR}" --password-stdin
          docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
          docker push ${DOCKER_IMAGE}:latest
        '''
      }
    }
  }

  post {
    always {
      sh 'docker logout || true'
    }
  }
}
